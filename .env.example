# Host bindings: loopback is the safe default. Change only behind auth/TLS.
LCF_BIND_HOST=127.0.0.1
WEB_PORT=8080
API_PORT=8000
MCP_PORT=8001

# Host directory mounted at /data. Keep it on a local, encrypted filesystem.
LOCAL_DATA_DIR=./data

# Read-only host directory for trusted local repositories. Compose exposes it
# as /imports; the backend only permits /examples and /imports local sources.
LOCAL_IMPORTS_DIR=./imports

# Remote clones are HTTPS/443 only and must match this exact host list.
# Add a self-hosted Git domain explicitly, or pre-clone it under imports/.
LCF_REMOTE_SOURCE_HOSTS=github.com,gitlab.com,bitbucket.org

# QMD 2.5.3 is installed in the API image. Hybrid is permitted by default, but
# the persisted model/corpus gate keeps queries lexical until a Web/API rebuild
# succeeds in this runtime.
LCF_QMD_ENABLED=true
LCF_QMD_HYBRID_ENABLED=true
# This seeds a new database. Change the live model through Web/API so the
# required global rebuild is queued and activated atomically.
QMD_EMBED_MODEL=hf:ggml-org/embeddinggemma-300M-GGUF/embeddinggemma-300M-Q8_0.gguf

# Deterministic cross-language symbol extraction.
LCF_CTAGS_ENABLED=true
LCF_CTAGS_TIMEOUT_SECONDS=120

# Generation provider is chosen on each ingest request: auto, codex_cli,
# cursor_cli, mock, or ollama. Web aliases codex/cursor to the CLI providers.
# For a Windows generator, use its PRIVATE LAN/VPN IP, never a public endpoint.
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen3.5:9b
OLLAMA_TIMEOUT_SECONDS=600
# High-coverage defaults. For an 8 GB RTX 4060, first reduce OLLAMA_NUM_CTX /
# OLLAMA_NUM_PREDICT and the LCF_MAX_MODEL_* outbound payload budgets below.
OLLAMA_NUM_CTX=32768
OLLAMA_NUM_PREDICT=8192

# All-in-one macOS deployments use a host-side LaunchAgent. The API exchanges
# bounded typed JSON through /data/runner; credentials are never mounted.
LCF_RUNNER_DIR=/data/runner
LCF_DEFAULT_PROVIDER=auto
LCF_HOST_RUNNER_TIMEOUT_SECONDS=1800
# These paths are populated in private .lcf/runtime.env by ./install.sh.
LCF_CODEX_BIN=
LCF_CURSOR_BIN=

# Legacy in-container Codex adapter only. The all-in-one host runner does not
# use this flag and keeps credentials outside the container.
LCF_ENABLE_CODEX_PROVIDER=false

# Persistent fact/evidence bounds.
LCF_MAX_FILE_BYTES=384000
LCF_MAX_SNAPSHOT_FILES=100000
LCF_MAX_SNAPSHOT_BYTES=2147483648
LCF_MAX_EVIDENCE_BYTES=240000

# Per-generation model payload bounds. These are independent from the larger
# persisted fact pack above and directly bound what is sent to Ollama/Codex.
LCF_MAX_EXISTING_WIKI_BYTES=20000
LCF_MAX_MODEL_PAYLOAD_BYTES=100000
LCF_MAX_MODEL_MANIFEST_BYTES=12000
LCF_MAX_MODEL_SYMBOLS_BYTES=25000
LCF_MAX_MODEL_EVIDENCE_BYTES=30000
LCF_MAX_MODEL_SYMBOLS=80
LCF_MAX_MODEL_MANIFEST_FILES=150
LCF_MAX_SYMBOLS=2000

# Browser origins allowed to call the API directly.
LCF_CORS_ORIGINS=http://127.0.0.1:8080,http://localhost:8080
# MCP gateway -> backend HTTP timeout. A consuming MCP host has its own,
# independent tool-call timeout (for Codex, set tool_timeout_sec = 660.0).
# QMD hybrid queries may use the backend's 600 s cold-start budget; prewarm it.
BACKEND_TIMEOUT_SECONDS=660
# Graceful Compose stop budget used by backup.sh for in-flight sync writers.
LCF_BACKUP_STOP_TIMEOUT_SECONDS=3600
