{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local-context-forge.invalid/schemas/renderer-build-manifest.schema.json",
  "title": "Local Context Forge renderer build manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "kind",
    "source",
    "files"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "kind": {
      "const": "local-context-forge-renderer-build"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repositoryCommit",
        "sourceDateEpoch",
        "packageLockSha256"
      ],
      "properties": {
        "repositoryCommit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "sourceDateEpoch": {
          "type": "integer",
          "minimum": 100000000
        },
        "packageLockSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "files": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "size",
          "sha256"
        ],
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]*$"
          },
          "size": {
            "type": "integer",
            "minimum": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    }
  }
}
