{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local-context-forge.invalid/schemas/renderer-build-manifest.schema.json",
  "title": "Local Context Forge renderer build manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "kind",
    "source",
    "builder",
    "files"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "kind": {
      "const": "local-context-forge-renderer-build"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repositoryCommit",
        "repositoryTree",
        "sourceSnapshotSha256",
        "sourceDateEpoch",
        "packageLockSha256",
        "inputSnapshotSha256",
        "inputFiles"
      ],
      "properties": {
        "repositoryCommit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "repositoryTree": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "sourceSnapshotSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "sourceDateEpoch": {
          "type": "integer",
          "minimum": 100000000
        },
        "packageLockSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "inputSnapshotSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "inputFiles": {
          "type": "integer",
          "minimum": 5
        }
      }
    },
    "builder": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version",
        "reactPluginVersion",
        "nodeVersion",
        "npmVersion",
        "installedContentSha256"
      ],
      "properties": {
        "name": { "const": "vite" },
        "version": { "const": "7.3.6" },
        "reactPluginVersion": { "const": "4.7.0" },
        "nodeVersion": { "const": "v22.23.2" },
        "npmVersion": { "const": "10.9.8" },
        "installedContentSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "files": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "size",
          "sha256"
        ],
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]*$"
          },
          "size": {
            "type": "integer",
            "minimum": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    }
  }
}
